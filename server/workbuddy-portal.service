[Unit]
Description=WorkBuddy Daily invite portal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=workbuddyportal
Group=workbuddyportal
WorkingDirectory=/opt/workbuddy-portal
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=WB_PORTAL_APP_STATE=/var/lib/workbuddy-portal/app
Environment=WB_PORTAL_METRICS=/var/lib/workbuddy-portal/metrics.sqlite
EnvironmentFile=/etc/workbuddy-portal-admin.env
ExecStart=/usr/bin/python3 /opt/workbuddy-portal/portal.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/workbuddy-portal/app
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
