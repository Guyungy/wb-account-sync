{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wb-account-sync",
  "version": "0.1.0",
  "identifier": "io.github.guyungy.wb-account-sync",
  "build": {
    "beforeDevCommand": "npm --prefix ../web run build",
    "beforeBuildCommand": "npm --prefix ../web run build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{"label":"main","title":"WorkBuddy 工作台","width":1120,"height":820,"minWidth":760,"minHeight":580}],
    "security": {"csp":"default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; base-uri 'none'; frame-ancestors 'none'"}
  },
  "bundle": {
    "active": true,
    "resources": {"../../LICENSE":"LICENSE", "../../THIRD_PARTY_NOTICES.md":"THIRD_PARTY_NOTICES.md", "../../docs/DESKTOP_GATEWAY.md":"HELP.md"},
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {"minimumSystemVersion":"11.0", "signingIdentity":"-"}
  }
}
